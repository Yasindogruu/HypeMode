rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kendi verilerin: sadece sen okur/yazarsın
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Arkadaş profili (kullanıcı adı, son antrenman özeti): giriş yapan herkes okur, sadece sahibi yazar
    match /social/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Dürtme, istek, beğeni, yorum: gönderen yazar; sadece gönderen ve alan görür/siler
    match /pokes/{id} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
    // Bildirim aboneliği: sahibi yazar, arkadaşlar bildirim göndermek için okur
    match /push/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
